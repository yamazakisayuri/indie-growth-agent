# App Store Connect API
# Users and Access → Integrations → App Store Connect API から取得
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX

# .p8 秘密鍵（どちらか一方）
# ローカル: ファイルパス（secrets/ に置き、リポジトリにはコミットしない）
APP_STORE_CONNECT_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8
# コンテナ / ECS: Secrets Manager から PEM 本文を注入（実値は書かない）
# APP_STORE_CONNECT_PRIVATE_KEY=

# 対象アプリ（設定で切り替え。コードにはアプリを固定しない）
# APP_ID または BUNDLE_ID のどちらか一方で指定。両方ある場合は APP_ID を優先。
# 未設定なら、API キー配下にアプリが1つだけのときのみ自動選択。
#
# 実際の値は .env に書く（.env は git 管理外）
APP_STORE_CONNECT_APP_ID=
APP_STORE_CONNECT_BUNDLE_ID=com.example.YourApp

# 集計対象テリトリー（例: JP）。全地域は ALL
APP_STORE_CONNECT_TERRITORY=JP

# 直近 N 日 vs 直前 N 日で比較
APP_STORE_CONNECT_LOOKBACK_DAYS=7

# 任意: 使う Analytics Report Request ID（未設定なら対象アプリの ONGOING を優先）
# アプリを切り替えたら、必要に応じてこちらも更新する
# APP_STORE_CONNECT_ANALYTICS_REQUEST_ID=

# --- Google Analytics 4 (OAuth / read-only) ---
# 対象プロパティ（設定で切り替え。未設定なら GA4 は not connected）
# 実際の値は .env に書く（.env は git 管理外）
GA4_PROPERTY_ID=

# Google OAuth クライアント（Desktop / Web）。.env は git 管理外
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# refresh token は secrets/ に置く（git 管理外）。中身を直接 .env に書く場合は GA4_REFRESH_TOKEN=
GA4_REFRESH_TOKEN_PATH=secrets/ga4_refresh_token.txt
# GA4_REFRESH_TOKEN=

# 任意: サービスアカウントを使う場合のみ（JSON は secrets/ に置き、リポジトリにコミットしない）
# GA4_SERVICE_ACCOUNT_PATH=secrets/ga4-service-account.json

# 任意: ASC と同じ日数を使うなら省略可
GA4_LOOKBACK_DAYS=7

# 任意: キーイベント名（カンマ区切り）。未設定なら key event counts は出さない
# 例: first_open,record_saved,ad_impression
GA4_KEY_EVENTS=

# 任意: イベント定義ファイル。未設定ならリポジトリ直下の event_definitions.json。
# ここに定義のあるイベントだけ Agent が意味を解釈でき、それ以外は不透明ラベル扱い。
# GA4_EVENT_DEFINITIONS_PATH=event_definitions.json

# --- Google AdMob (OAuth / read-only, Agent 統合済み) ---
# GA4 と同じ GOOGLE_OAUTH_CLIENT_* を流用可。refresh token は別ファイル（スコープが違う）。
# 取得例: python scripts/oauth_admob.py
# 未設定なら AdMob は not connected
ADMOB_ACCOUNT_ID=pub-xxxxxxxxxxxxxxxx
# 対象アプリ（ca-app-pub-…~…）。カンマ区切り可。未設定ならアカウント配下の全アプリを APP 次元で取得。
# ADMOB_APP_ID=
# ADMOB_APP_IDS=
ADMOB_REFRESH_TOKEN_PATH=secrets/admob_refresh_token.txt
# ADMOB_REFRESH_TOKEN=
# 任意: ASC と同じ日数を使うなら省略可
ADMOB_LOOKBACK_DAYS=7
ADMOB_CURRENCY_CODE=JPY

# --- Growth Agent MCP (Planner knowledge provider; optional) ---
# Clone/build outside this repo. If unset, Analyzer still works; Planner is skipped.
# Local build example:
#   GROWTH_MCP_COMMAND=node
#   GROWTH_MCP_ARGS=/absolute/path/to/growth-agent-mcp/dist/index.js
# Future npm package:
#   GROWTH_MCP_COMMAND=npx
#   GROWTH_MCP_ARGS=-y growth-agent-mcp
# Optional working directory:
# GROWTH_MCP_CWD=
# GROWTH_MCP_COMMAND=
# GROWTH_MCP_ARGS=

# Optional standing constraints for Planner (budget / time / tools).
# Default: repository-root GROWTH.md when present. Set path to override, or leave
# unset and omit the file to run Planner without GROWTH.md constraints.
# GROWTH_MD_PATH=GROWTH.md

# Optional Product / Channel config (non-secret connection IDs).
# When present, overlays ASC/GA4/AdMob identity from product.json.
# Secrets stay in this .env file. Missing product.json → env-only (backward compatible).
# PRODUCT_JSON_PATH=product.json

# Default: repository-root known_events.json when present.
# KNOWN_EVENTS_PATH=known_events.json
# Days before Analyzer period start still included (default 21):
# KNOWN_EVENTS_LOOKBACK_DAYS=21
# Optional product filter override (else derived from bundle id when mapped):
# KNOWN_EVENTS_PRODUCT=mahjong

# --- Amazon Bedrock (Strands Agents 既定モデル) ---
# AWS 認証情報はリポジトリに置かない（環境変数 / 共有 credentials / IAM ロール等を使う）
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# --- Web API (python api_server.py / Docker / ECS) ---
# Bind address and port (containers: HOST=0.0.0.0, PORT=8080)
# HOST=0.0.0.0
# PORT=8000
#
# Comma-separated extra CORS origins (Amplify URL etc.). Localhost defaults remain.
# CORS_ALLOWED_ORIGINS=https://main.d123.amplifyapp.com
#
# Frontend (web/.env.local or Amplify build env) — public API URL only, never secrets:
# NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8000
