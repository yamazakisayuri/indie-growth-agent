# App Store Connect API
# Users and Access → Integrations → App Store Connect API から取得
APP_STORE_CONNECT_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
APP_STORE_CONNECT_KEY_ID=XXXXXXXXXX

# .p8 秘密鍵のパス（リポジトリ直下からの相対パス、または絶対パス）
# ファイル本体は secrets/ に置き、このリポジトリにはコミットしない
APP_STORE_CONNECT_PRIVATE_KEY_PATH=secrets/AuthKey_XXXXXXXXXX.p8

# 対象アプリ（設定で切り替え。コードにはアプリを固定しない）
# APP_ID または BUNDLE_ID のどちらか一方で指定。両方ある場合は APP_ID を優先。
# 未設定なら、API キー配下にアプリが1つだけのときのみ自動選択。
#
# 実際の値は .env に書く（.env は git 管理外）
APP_STORE_CONNECT_APP_ID=
APP_STORE_CONNECT_BUNDLE_ID=com.example.YourApp

# 集計対象テリトリー（例: JP）。全地域は ALL
APP_STORE_CONNECT_TERRITORY=JP

# 直近 N 日 vs 直前 N 日で比較
APP_STORE_CONNECT_LOOKBACK_DAYS=7

# 任意: 使う Analytics Report Request ID（未設定なら対象アプリの ONGOING を優先）
# アプリを切り替えたら、必要に応じてこちらも更新する
# APP_STORE_CONNECT_ANALYTICS_REQUEST_ID=

# --- Google Analytics 4 (OAuth / read-only) ---
# 対象プロパティ（設定で切り替え。未設定なら GA4 は not connected）
# 実際の値は .env に書く（.env は git 管理外）
GA4_PROPERTY_ID=

# indie-growth と同じ OAuth クライアントを流用（.env は git 管理外）
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# refresh token は secrets/ に置く（git 管理外）。中身を直接 .env に書く場合は GA4_REFRESH_TOKEN=
GA4_REFRESH_TOKEN_PATH=secrets/ga4_refresh_token.txt
# GA4_REFRESH_TOKEN=

# 任意: サービスアカウントを使う場合のみ
# GA4_SERVICE_ACCOUNT_PATH=secrets/ga4-service-account.json

# 任意: ASC と同じ日数を使うなら省略可
GA4_LOOKBACK_DAYS=7

# 任意: キーイベント名（カンマ区切り）。未設定なら key event counts は出さない
GA4_KEY_EVENTS=first_open,record_saved,ad_impression

# 任意: イベント定義ファイル。未設定ならリポジトリ直下の event_definitions.json。
# ここに定義のあるイベントだけ Agent が意味を解釈でき、それ以外は不透明ラベル扱い。
# GA4_EVENT_DEFINITIONS_PATH=event_definitions.json
